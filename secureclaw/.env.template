# SecureClaw Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ── Required ──
ANTHROPIC_API_KEY=                  # From console.anthropic.com → API Keys

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_TOKEN=                     # Meta Developer Console → WhatsApp → API Setup
WHATSAPP_PHONE_ID=                  # Meta Developer Console → Phone Number ID
WHATSAPP_APP_SECRET=                # App Settings → App Secret (for signature verification)
WEBHOOK_VERIFY_TOKEN=               # Any random string (must match Meta webhook config)

# ── Admin ──
ADMIN_PHONE=+6512345678             # Your WhatsApp number in E.164 format

# ── Vault ──
VAULT_ENCRYPTION_KEY=               # Leave blank — auto-generated on first run

# ── Rate Limiting ──
# RATE_LIMIT_MAX=30                 # Max messages per window (default: 30)
# RATE_LIMIT_WINDOW=3600            # Window in seconds (default: 3600 = 1 hour)

# ── AI Model ──
# CLAUDE_MODEL=claude-sonnet-4-5-20250929   # Default model (override if needed)
# MAX_RESPONSE_TOKENS=1024                   # Max tokens per response

# ── CORS (optional — restrict webhook origins) ──
# CORS_ORIGINS=                    # Comma-separated allowed origins (blank = no CORS middleware)

# ── Logging ──
# LOG_FORMAT=text                  # "text" (default) or "json" (structured logging)

# ── Skill API Keys (stored in vault after first use) ──
# TAVILY_API_KEY=                   # For web search skill
# OPENWEATHER_API_KEY=              # For weather skill
